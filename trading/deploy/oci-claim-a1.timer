[Unit]
Description=Retry claiming free Ampere A1 capacity every 15 minutes

[Timer]
# Oracle throttles instance launches per tenancy with 429 TooManyRequests;
# attempts minutes apart get rejected before they ever reach the capacity check.
OnBootSec=5min
OnUnitActiveSec=15min
RandomizedDelaySec=300
AccuracySec=30s

[Install]
WantedBy=timers.target
